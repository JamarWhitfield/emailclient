# Copy this file to .env and fill in the values before using --send.
# Keep .env local to Kellie's machine and do not commit it.

# Choose how email is sent:
#   smtp  -> send through Microsoft 365 / Outlook with an app password (simplest)
#   gmail -> send through the Gmail API (Google accounts only)
EMAIL_PROVIDER=smtp
SENDER_EMAIL=kellie@fdltitle.com

# --- SMTP settings (used when EMAIL_PROVIDER=smtp) ------------------------
# For Microsoft 365 / Outlook the defaults below are correct.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Usually the same as SENDER_EMAIL. Leave blank to reuse SENDER_EMAIL.
SMTP_USERNAME=kellie@fdltitle.com
# An APP PASSWORD from the account's security settings (requires MFA on).
# This is a secret -- never commit it.
SMTP_PASSWORD=wjmhyvfpzxzdhdlj


# --- Gmail API settings (used only when EMAIL_PROVIDER=gmail) -------------
# Gmail API desktop OAuth file downloaded from Google Cloud.
GMAIL_CREDENTIALS_FILE=credentials.json
# OAuth token file created automatically after Kellie signs in once.
GMAIL_TOKEN_FILE=token.json